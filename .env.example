# From @BotFather
BOT_TOKEN=

# Optional. Leave both blank to use the standard cloud API (50MB upload limit).
# Fill both in (from https://my.telegram.org/apps, personal account) AND
# uncomment COMPOSE_PROFILES below to run a local Bot API server sidecar that
# raises the upload limit to 2GB.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# COMPOSE_PROFILES=local-api

# Optional. Cuma dibutuhkan buat fitur /transcribe (voice note -> teks).
# Bikin API key gratis di https://console.groq.com/keys
GROQ_API_KEY=
